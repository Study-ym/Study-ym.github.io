---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { publicNotes } from '../../lib/content';
import { stages, formatDate, site } from '../../site';
export async function getStaticPaths() { return (await publicNotes()).map(note => ({ params: { id: note.id }, props: { note } })); }
const { note } = Astro.props;
const { Content, headings } = await render(note);
---
<Layout title={note.data.title} description={note.data.description} active="notes">
  <a class="back-link" href="/notes/"><Icon name="arrow" size={16}/>所有记录</a>
  <header class="article-header"><div class="entry-meta"><span class={`stage ${note.data.stage}`}><span></span>{stages[note.data.stage].label}</span><time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>{note.data.updated && <span>更新于 {formatDate(note.data.updated)}</span>}</div><h1>{note.data.title}</h1><p>{note.data.description}</p><div class="tags">{note.data.tags.map(tag => <a href={`/notes/?tag=${encodeURIComponent(tag)}`}>#{tag}</a>)}</div></header>
  {note.data.example && <p class="example-notice">这是一篇示例记录，用来演示花园的内容格式。</p>}
  <div class="article-layout"><article class="prose"><Content /></article>{headings.some(h => h.depth === 2) && <nav class="toc" aria-label="文章目录"><h2>这篇记录</h2>{headings.filter(h => h.depth === 2).map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav>}</div>
  <div class="article-end"><span>这条记录可以继续生长。</span><a href={`${site.repo}/edit/main/${note.filePath}`} target="_blank" rel="noopener noreferrer">在 GitHub 编辑<Icon name="external" size={12}/></a></div>
</Layout>
