---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { publicIdeas } from '../lib/content';
import { gardenModules } from '../site';
const modules = gardenModules(import.meta.env.PUBLIC_GARDEN_CLOUD === 'true');
const ideas = await publicIdeas();
const details: Record<string, string> = {
  ideas: `${ideas.length} 个想法`, private: '登录后进入',
  tools: 'JSON / 时间戳 / URL', games: '2048', other: '打开更多内容',
};
---
<Layout>
  <section class="command-center" aria-label="花园模块导航">
    <div class="console-meta"><span>模块导航</span><time id="console-date"></time></div>
    <div class="console-grid">
      {modules.map(module => <a class={`module-link module-${module.key}`} href={module.url}>
        <span class="module-symbol"><Icon name={module.icon} size={25}/></span>
        <div class="module-copy"><h2>{module.label}</h2><p>{module.description}</p><small class="module-detail">{details[module.key]}</small></div>
        <span class="module-arrow"><Icon name="arrow" size={17}/></span>
      </a>)}
      <div class="reactor">
        <svg class="reactor-rings" viewBox="0 0 400 400" fill="none" aria-hidden="true">
          <defs><radialGradient id="core-glow"><stop stop-color="#65e0f0" stop-opacity=".10"/><stop offset="1" stop-color="#65e0f0" stop-opacity="0"/></radialGradient></defs>
          <circle cx="200" cy="200" r="199" fill="url(#core-glow)"/>
          <g stroke="currentColor">
            <circle cx="200" cy="200" r="185" stroke-opacity=".15"/>
            <circle cx="200" cy="200" r="172" stroke-width="2" stroke-dasharray="1 11" stroke-opacity=".4"/>
            <circle cx="200" cy="200" r="160" stroke-width="3" stroke-dasharray="195 57" transform="rotate(-32 200 200)" stroke-opacity=".7"/>
            <circle cx="200" cy="200" r="148" stroke-opacity=".24"/>
            <circle cx="200" cy="200" r="132" stroke-width="1.5" stroke-dasharray="112 96" transform="rotate(15 200 200)" stroke-opacity=".6"/>
            <path d="M200 4v18m0 356v18M4 200h18m356 0h18M54 54l10 10m272 272 10 10M54 346l10-10M336 64l10-10" stroke-opacity=".7"/>
            <path d="m186 48 14-8 14 8m-28 304 14 8 14-8" stroke-opacity=".45"/>
          </g>
        </svg>
        <div class="reactor-label"><h1>余安<span>数字花园</span></h1><button class="core-search" data-search-open><Icon name="search" size={15}/>搜索内容</button></div>
      </div>
    </div>
  </section>
  <script>
    const date = document.querySelector<HTMLTimeElement>('#console-date');
    if (date) { const now = new Date(); date.dateTime = now.toISOString(); date.textContent = new Intl.DateTimeFormat('zh-CN', {year:'numeric',month:'2-digit',day:'2-digit',weekday:'short'}).format(now); }
  </script>
</Layout>
