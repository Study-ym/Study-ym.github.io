---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../site';
const links = [
  {label:'客户到期提醒', description:'面向海外客户的服务试验：查看英文介绍与交互演示。', url:'/services/renewal-reminders/', icon:'tools'},
  {label:'记录', description:'学习笔记、生活片段与长一点的思考。', url:'/notes/', icon:'book'},
  {label:'关于', description:'认识这座花园。', url:'/about/', icon:'reactor'},
  {label:'GitHub', description:'代码、项目与正在做的东西。', url:site.github, icon:'github'},
  {label:'RSS 订阅', description:'在阅读器中接收公开记录。', url:'/rss.xml', icon:'link'},
];
---
<Layout title="其他" active="other">
  <header class="page-heading"><h1>其他</h1><p>记录，以及花园的更多连接。</p></header>
  <div class="directory-grid">{links.map(link => <a class="directory-link" href={link.url} target={link.url.startsWith('https:') ? '_blank' : undefined} rel={link.url.startsWith('https:') ? 'noopener noreferrer' : undefined}><Icon name={link.icon} size={25}/><div><h2>{link.label}</h2><p>{link.description}</p></div><Icon name={link.url.startsWith('https:') ? 'external' : 'arrow'} size={17}/></a>)}</div>
</Layout>
